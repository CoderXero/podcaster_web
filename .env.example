# Comma-separated entries: token=role:user
PODCASTER_WEB_TOKENS=change-me=publisher:local-admin

# Server-to-server Gumu-Gumu OAuth2 client credentials.
PODCAST_CLIENT_ID=replace-me
PODCAST_CLIENT_SECRET=replace-me
OAUTH_DISCOVERY_URL=https://identity.example/.well-known/openid-configuration
# OAUTH_TOKEN_URL=https://identity.example/oauth/token
# OAUTH_SCOPE=gumu.admin
# OAUTH_AUDIENCE=https://api.example
# GUMU_API_BASE_URL=https://api.example

# Use the platform path separator when listing multiple roots.
PODCASTER_WEB_SOURCE_ROOTS=./articles
PODCASTER_WEB_AUTH_MODE=disabled
# Publishing remains fail-closed until the remote contract and credentials
# have been validated for this environment.
PODCASTER_WEB_ENABLE_PUBLISH=false
PODCASTER_WEB_CONTRACT_VALIDATED=false

# Optional local overrides.
# PODCASTER_WEB_HOST=127.0.0.1
# PODCASTER_WEB_PORT=8080
# PODCASTER_WEB_DATABASE=podcaster-web.sqlite3
# PODCASTER_LLM_BASE_URL=http://openai.api.tiiny/v1
# PODCASTER_LLM_MODEL=openai/gpt-oss-120b
# PODCASTER_LLM_REASONING_EFFORT=low
# PODCASTER_LLM_TIMEOUT_SECONDS=180
# PODCASTER_LLM_MAX_OUTPUT_TOKENS=1600
# TIINY_OPENAI_API_KEY=replace-me
ELEVENLABS_API_KEY=replace-me
# JSON array with exactly two ElevenLabs voice IDs: host first, guest second.
ELEVENLABS_VOICE_IDS=["replace-host-voice-id","replace-guest-voice-id"]
